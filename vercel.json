    },
    {
      "source": "/windows",
      "destination": "/index.html"
    },
    {
      "source": "/engineering",
      "destination": "/index.html"
    },
    {
      "source": "/compare",
      "destination": "/index.html"
    },
    {
      "source": "/science",
      "destination": "/index.html"
    },
    {
      "source": "/planner",
      "destination": "/index.html"
    },
    {
      "source": "/finder",
      "destination": "/index.html"
    },
    {
      "source": "/methodology",
      "destination": "/index.html"
    }
  ]
