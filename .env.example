# LunarNav V2 — Gemini mission assistant environment configuration
# Copy to .env for local serverless testing, or set these in the Vercel
# dashboard (Settings → Environment Variables). Never commit real values.

# Required: Google AI Studio / Vertex API key used only by api/chat.js.
GEMINI_API_KEY=

# Optional: model id sent to the Gemini API. Defaults to gemini-3.8-flash
# when unset. Any model supporting function calling may be used.
# Older deployments using retired models (e.g. gemini-2.0-flash) must set
# this to a currently available model such as gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Optional: comma-separated fallback models tried when GEMINI_MODEL returns a
# transient error (429 quota, 503 high demand, a hang, or is retired/unknown).
# Defaults to gemini-3.5-flash,gemini-3.1-flash-lite when unset.
GEMINI_FALLBACK_MODELS=